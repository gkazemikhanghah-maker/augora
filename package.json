{
  "name": "augora",
  "version": "0.1.0",
  "private": true,
  "description": "Augora — fully-collateralized binary prediction market (MVP)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @augora/server",
    "dev:web": "npm run dev --workspace @augora/web",
    "start": "npm run start --workspace @augora/server",
    "build:web": "npm run build --workspace @augora/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "@types/ws": "^8.5.10",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
